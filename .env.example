# Zerodha Kite API (from kite.zerodha.com)
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret
# After login, set access token (refresh daily or use session)
KITE_ACCESS_TOKEN=

# Groww Trading API (https://groww.in/trade-api)
GROWW_API_KEY=
GROWW_API_SECRET=
# Optional seed — paste today's token or use Connect popup in UI
GROWW_ACCESS_TOKEN=
# Auto-sync MyTrade tables after market close (Mon–Fri IST, default 16:00)
GROWW_EOD_SYNC_ENABLED=true
GROWW_EOD_SYNC_HOUR=16
GROWW_EOD_SYNC_MINUTE=0

# ── Local Postgres (see also config/database.yaml) ──────────────
# Preferred: individual fields (schema = Tradele in pgAdmin)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_SCHEMA=Tradele
DB_AUTO_CREATE_TABLES=false

# Optional: full URL override (if set, wins over DB_HOST/DB_NAME/…)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Telegram Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (SMTP) for alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# LLM provider: claude_cli | gemini | openai (primary + fallbacks)
LLM_PROVIDER=claude_cli
LLM_FALLBACK=gemini,openai

# Claude Code CLI — uses Pro/Max via `claude auth login` (not API key billing)
# Install: https://code.claude.com  then: claude auth login
CLAUDE_CLI_PATH=
CLAUDE_CLI_MODEL=sonnet
CLAUDE_CLI_TIMEOUT=300
CLAUDE_CLI_USE_SUBSCRIPTION=true

# OpenAI-compatible API (fallback / when LLM_PROVIDER=openai)
OPENAI_API_KEY=
LLM_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Gemini (fallback / when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Momentum agent scan size
MOMENTUM_MAX_SYMBOLS=50

# Optional: Apify / Screener.in
APIFY_API_TOKEN=

# App
TZ=Asia/Kolkata
LOG_LEVEL=INFO
# Public UI origin (broker OAuth return). Local: http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
# Extra CORS origins (comma-separated). Production defaults already include tradele.pro
CORS_ORIGINS=https://tradele.pro,https://www.tradele.pro
